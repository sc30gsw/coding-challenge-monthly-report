    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@valibot/to-json-schema": "^1.7.1",
    "better-result": "^3.0.1",
    "cnfast": "^0.1.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-valibot": "^0.4.2",
    "elysia": "^1.4.29",
    "pg": "^8.23.0",
    "react": "^19.2.7",
