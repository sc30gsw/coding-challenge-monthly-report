# このファイルをコピーして .env を作ります。実値はコミットしません。
#   cp .env.example .env
# `vp run setup` を使う場合は、このコピーと COOKIE_SECRET の生成まで自動で行われます。

# ---------------------------------------------------------------------------
# データベース
# ---------------------------------------------------------------------------
# docker-compose.yml のデフォルトに合わせた接続先です。
# 外部の PostgreSQL を使う場合はここを差し替えてください（Docker は不要になります）。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monthly_report

# テスト用データベース。docker-compose の初期化スクリプトで同時に作られます。
# API integration とフロント integration のテストがこちらを使い、テストごとに truncate します。
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/monthly_report_test

# ---------------------------------------------------------------------------
# 認証（ダミーログイン）
# ---------------------------------------------------------------------------
# ログイン中のユーザー ID を入れる Cookie の署名鍵です。
# 署名が無いと開発者ツールで Cookie を書き換えるだけで他人になれるため、必須にしています。
# 詳細は docs/adr/0015-signed-cookie-dummy-login.md を参照してください。
#
# 生成:
#   openssl rand -base64 32
#
# 実値はこのファイルに書かず、.env にだけ置いてください。
COOKIE_SECRET=
